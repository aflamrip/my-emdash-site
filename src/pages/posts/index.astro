---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base.astro from "../../layouts/Base.astro"; // عدل مسار الـ Layout حسب مشروعك

const cursor = Astro.url.searchParams.get("cursor") || undefined;

// 1. جلب بيانات مجموعة "movies" من EmDash CMS
const {
	entries: movies,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("movies", {
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// 2. جلب التصنيفات (Genres / Categories) للأفلام
const genresByEntry = await getTermsForEntries(
	"movies",
	movies.map((m) => m.data.id),
	"genre", // نفترض أن التصنيف اسمه genre في EmDash
);

const moviesWithGenres = movies.map((movie) => ({
	movie,
	genres: genresByEntry.get(movie.data.id) ?? [],
}));

const formatYear = (date: Date) => new Date(date).getFullYear();
---

<Base title="قائمة الأفلام والمسلسلات" description="استحدث أحدث الأفلام والمسلسلات بجودات عالية">
	<div class="movies-page">
		<header class="page-header">
			<h1 class="page-title">أحدث الأفلام والمسلسلات</h1>
			<p class="page-description">
				{movies.length} عمل متوفر للمشاهدة
			</p>
		</header>

		{
			movies.length === 0 ? (
				<p class="empty">لا توجد أعمال مضافة حالياً.</p>
			) : (
				/* شبكة عرض الأفلام بنظام Grid لتناسب البوسترات */
				<div class="movies-grid">
					{moviesWithGenres.map(({ movie, genres }) => (
						<article class="movie-card">
							<a href={`/movies/${movie.id}`} class="movie-link">
								<div class="poster-container">
									{/* عرض بوستر الفيلم أو المسلسل */}
									{movie.data.posterMediaId ? (
										<img
											src={`/_emdash/api/media/file/${movie.data.posterMediaId}`}
											alt={movie.data.title}
											class="movie-poster"
											loading="lazy"
										/>
									) : (
										<div class="no-poster">لا يوجد بوستر</div>
									)}
									{/* شارة الجودة أو التقييم */}
									{movie.data.quality && (
										<span class="movie-quality">{movie.data.quality}</span>
									)}
								</div>

								<div class="movie-info">
									<div class="movie-meta">
										{movie.data.publishedAt && (
											<span>{formatYear(movie.data.publishedAt)}</span>
										)}
										{movie.data.rating && (
											<>
												<span class="meta-dot" />
												<span class="movie-rating">⭐ {movie.data.rating}</span>
											</>
										)}
									</div>
									<h2 class="movie-title" {...movie.edit.title}>{movie.data.title}</h2>
								</div>
							</a>

							{/* التصنيفات */}
							{genres.length > 0 && (
								<div class="movie-genres">
									{genres.slice(0, 2).map((g) => (
										<a href={`/genre/${g.slug}`} class="genre-tag">
											{g.label}
										</a>
									))}
								</div>
							)}
						</article>
					))}
				</div>
			)
		}

		<nav class="pagination" aria-label="Pagination">
			{cursor && <a href="/movies" class="page-btn">الصفحة الأولى</a>}
			{
				nextCursor && (
					<a href={`/movies?cursor=${encodeURIComponent(nextCursor)}`} class="page-btn">
						الصفحة التالية
					</a>
				)
			}
		</nav>
	</div>
</Base>

<style>
	.movies-page {
		max-width: 1400px;
		margin: 0 auto;
		padding: var(--spacing-8) var(--spacing-6) var(--spacing-16);
	}

	.page-header {
		margin-bottom: var(--spacing-8);
		text-align: center;
	}

	.page-title {
		font-size: var(--font-size-3xl);
		font-weight: bold;
		margin-bottom: var(--spacing-2);
	}

	.page-description {
		color: var(--color-muted);
	}

	.empty {
		text-align: center;
		color: var(--color-muted);
		font-size: var(--font-size-lg);
	}

	/* شبكة البوسترات المخصصة للموبايل والويب */
	.movies-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
		gap: var(--spacing-6);
	}

	.movie-card {
		background: var(--color-surface, #1e293b);
		border-radius: var(--radius, 12px);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		transition: transform 0.2s ease, box-shadow 0.2s ease;
	}

	.movie-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 10px 20px rgba(0,0,0,0.3);
	}

	.movie-link {
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.poster-container {
		position: relative;
		aspect-ratio: 2 / 3; /* نسبة أبعاد البوستر القياسية للأفلام */
		background: #0f172a;
		overflow: hidden;
	}

	.movie-poster {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.no-poster {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 100%;
		color: var(--color-muted);
		font-size: 12px;
	}

	.movie-quality {
		position: absolute;
		top: 8px;
		right: 8px;
		background: #ef4444;
		color: #fff;
		font-size: 10px;
		font-weight: bold;
		padding: 2px 6px;
		border-radius: 4px;
	}

	.movie-info {
		padding: var(--spacing-3);
		display: flex;
		flex-direction: column;
		gap: 4px;
		flex: 1;
	}

	.movie-meta {
		display: flex;
		align-items: center;
		gap: var(--spacing-2);
		font-size: 12px;
		color: var(--color-muted);
	}

	.meta-dot {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: var(--color-muted);
	}

	.movie-title {
		font-size: 15px;
		font-weight: 600;
		line-height: 1.4;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.movie-genres {
		padding: 0 var(--spacing-3) var(--spacing-3);
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
	}

	.genre-tag {
		font-size: 10px;
		background: rgba(255, 255, 255, 0.1);
		color: var(--color-text-secondary);
		padding: 2px 6px;
		border-radius: 4px;
		text-decoration: none;
	}

	.pagination {
		margin-top: var(--spacing-12);
		display: flex;
		justify-content: center;
		gap: var(--spacing-4);
	}

	.page-btn {
		padding: 8px 16px;
		background: #334155;
		color: #fff;
		border-radius: 8px;
		text-decoration: none;
		font-size: 14px;
	}

	/* تحسينات الشاشات الصغيرة والموبايل */
	@media (max-width: 600px) {
		.movies-grid {
			grid-template-columns: repeat(2, 1fr); /* عمودين في شاشات الموبايل لتشبه منصات البث الكبرى */
			gap: var(--spacing-3);
		}
		.movies-page {
			padding: var(--spacing-4) var(--spacing-2);
		}
	}
</style>
